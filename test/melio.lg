;; io/system builtins on the melange backend via the Lg_node bridge
(:require [lg.str :as str] [lg.io :as io])
(io/spit "/tmp/lg_melio.txt" "melange io\n")
(println (io/slurp "/tmp/lg_melio.txt"))
(println (str (io/file-exists? "/tmp/lg_melio.txt")))
(println (str (io/file-exists? "/tmp/lg_no_such")))
(println (str (io/env "LG_DEFINITELY_MISSING_VAR")))
(println (str (io/argv)))
(println (io/sh "echo hi"))
(println (str (< 0 (io/now-ms))))
(println (str (str/re-find "[0-9]+" "abc123")))
(println (str (str/re-matches "[a-z]+" "abc")))
(println (str (str/re-matches "[a-z]+" "abc1")))
(println (str (str/re-seq "[0-9]+" "a1b22")))
(println (str (str/re-split "[0-9]+" "a1b22c")))
(println (str/re-replace "[0-9]+" "a1b" "#"))
