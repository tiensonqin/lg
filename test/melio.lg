;; io/system builtins on the melange backend via the Lg_node bridge
(spit "/tmp/lg_melio.txt" "melange io\n")
(println (slurp "/tmp/lg_melio.txt"))
(println (str (file-exists? "/tmp/lg_melio.txt")))
(println (str (file-exists? "/tmp/lg_no_such")))
(println (str (env "LG_DEFINITELY_MISSING_VAR")))
(println (str (argv)))
(println (sh "echo hi"))
(println (str (< 0 (now-ms))))
(println (str (re-find "[0-9]+" "abc123")))
(println (str (re-matches "[a-z]+" "abc")))
(println (str (re-matches "[a-z]+" "abc1")))
(println (str (re-seq "[0-9]+" "a1b22")))
(println (str (re-split "[0-9]+" "a1b22c")))
(println (re-replace "[0-9]+" "a1b" "#"))
