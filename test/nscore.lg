;; builtin namespaces: lg.str / lg.io / lg.set resolve qualified only.
(:require [lg.str :as str] [lg.io :as io] [lg.set :as set])
(println (str/join "-" ["a" "b" "c"]))
(println (str/join '(1 2 3)))
(println (str (str/trim "  x  ") (str/upper-case "ab") (str/includes? "abc" "b")))
(println (str (str/split "a,b" ",")))
(println (str (str/subs "hello" 1 3)))
(println (str (str/re-find "[0-9]+" "ab12")))
(println (str (str/re-replace "[0-9]" "a1b2" "#")))
(println (str (io/file-exists? "/tmp") (io/file-exists? "/nope-lg-xyz")))
(io/spit "/tmp/lg_nscore.txt" "io ok")
(println (io/slurp "/tmp/lg_nscore.txt"))
(println (str (count (io/argv))))
(println (set/union #{1 2} #{2 3}))
(println (set/intersection #{1 2} #{2 3}))
(println (set/difference #{1 2 3} #{2}))
(println (str (set/subset? #{1} #{1 2}) (set/superset? #{1 2} #{1})))
(println (set/select (fn [x] (> x 1)) #{1 2 3}))
;; full-path form works without :as
(println (lg.str/trim "  full  "))
