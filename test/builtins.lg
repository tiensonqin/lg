(ns builtins-test)

;; comp / juxt / partial
(println (str "comp " ((comp inc inc) 5)))
(println (str "juxt " ((juxt inc dec) 10)))
(println (str "partial " ((partial * 3) 7)))

;; update / get-in / assoc-in
(def m {:a 1 :b 2})
(println (str "update " (update m :a inc)))
(println (str "update-missing " (update m :z inc 0) " " (update m :z (fn [x] (+ x 10)) 5)))
(def deep {:x {:y {:z 5}}})
(println (str "get-in " (get-in deep [:x :y :z])))
(println (str "assoc-in " (assoc-in {:x {:y 1}} [:x :w] 9)))

;; seq fns
(println (str "mapcat " (mapcat (fn [x] (list x x)) '(1 2))))
(println (str "interpose " (interpose 0 '(1 2 3))))
(println (str "reverse " (reverse '(1 2 3)) " " (reverse [1 2 3])))
(println (str "distinct " (distinct '(1 1 2 2 3))))
(println (str "second " (second '(5 6 7))))
(println (str "last " (last '(5 6 7))))
(println (str "butlast " (butlast '(1 2 3 4))))
(println (str "take-while " (take-while (fn [x] (< x 3)) '(1 2 3 4))))
(println (str "drop-while " (drop-while (fn [x] (< x 3)) '(1 2 3 4))))
(println (str "sort " (sort '(3 1 2)) " " (sort-by (fn [x] (- 0 x)) '(1 3 2))))
(println (str "group-by " (group-by (fn [x] (mod x 2)) '(1 2 3 4))))
(println (str "frequencies " (frequencies '(a b a c b a))))

;; predicates / minmax
(println (str "every " (every? (fn [x] (> x 0)) '(1 2 3)) " " (every? (fn [x] (> x 0)) '(1 -2))))
(println (str "some " (some (fn [x] (> x 3)) '(1 2 4)) " " (some? (first '(9))) " " (some? None)))
(println (str "minmax " (min 3 7) " " (max 3 7)))
(println (str "minf " (min 1.5 2.5) " " (max 1.5 2.5)))
