;; loop/recur, case, defrecord, map?
(println (loop [i 0 acc 0] (if (< i 10) (recur (+ i 1) (+ acc i)) acc)))
(println (loop [x 10] (if (<= x 0) "done" (recur (- x 1)))))
(println (case 2 1 "one" 2 "two" "other"))
(println (case "x" "a" 1 "b" 2 0))
(defrecord Point [x y])
(def p (->Point 1 2))
(println (get p :x))
(println (+ (get p :x 0) (get p :y 0)))
(println (Point? p))
(println (Point? {:x 1}))
(println (map? {:a 1}))
(println (map? [1 2]))
(defrecord Pair [a b])
(println (get (->Pair "l" "r") :b))
