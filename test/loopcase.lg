;; named-fn self-recursion, case, defrecord, map?
(println (let [f (fn f [i acc] (if (< i 10) (f (+ i 1) (+ acc i)) acc))] (f 0 0)))
(println (let [g (fn g [x] (if (<= x 0) "done" (g (- x 1))))] (g 10)))
(println (case 2 1 "one" 2 "two" "other"))
(println (case "x" "a" 1 "b" 2 0))
(defrecord Point [x y])
(def p (->Point 1 2))
(println (get p :x))
(println (+ (get p :x 0) (get p :y 0)))
(println (Point? p))
(println (Point? {:x 1}))
(println (map? {:a 1}))
(println (map? [1 2]))
(defrecord Pair [a b])
(println (get (->Pair "l" "r") :b))
