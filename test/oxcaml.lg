;; --backend=oxcaml: local_ on borrowed top-level params; stack_ on
;; direct literal allocations; see test/oxlocal.lg for the collection
;; borrow paths (needs the clj-core/rrbvec `ox` pins)
(defn bump [x] (+ x 1))
(defn sum-to [n acc] (if (<= n 0) acc (sum-to (- n 1) (+ acc n))))
(println (bump 41))
(println (sum-to 100 0))
(let [v [1 2 3]] (println (conj v 4)))
(def keep [1 2 3])
(println (get keep 0))
