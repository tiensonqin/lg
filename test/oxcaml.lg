;; --backend=oxcaml: local_ on primitive top-level params; stack_ /
;; unique_ / binding local_ lower to (* … *) comments until clj-core
;; declares @ local params
(defn bump [x] (+ x 1))
(defn sum-to [n acc] (if (<= n 0) acc (sum-to (- n 1) (+ acc n))))
(println (bump 41))
(println (sum-to 100 0))
(let [v [1 2 3]] (println (conj v 4)))
(def keep [1 2 3])
(println (get keep 0))
