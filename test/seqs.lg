;; sequence ops over list/vec/set
(def xs '(1 2 3 4 5))
(def v [5 3 8 1 9 2])
(println (str (map inc xs)))
(println (str (filter even? xs)))
(println (str (reduce + 0 xs) " " (mapv (fn [x] (* x x)) v) " " (filterv odd? v)))
(println (str (take 3 xs) " " (drop 3 xs) " " (take-while (fn [x] (< x 4)) xs) " " (drop-while (fn [x] (< x 4)) xs)))
(println (str (some (fn [x] (= x 3)) xs) " " (every? (fn [x] (> x 0)) xs)))
(println (str (concat '(1) [2 3] '(4 5))))
(println (str (interpose 0 '(1 2 3)) " " (distinct '(1 2 2 3 1)) " " (reverse xs)))
(println (str (second xs) " " (last xs) " " (butlast xs) " " (next xs)))
(println (str (zipmap [:a :b] [1 2]) " " (frequencies '(a b a)) " " (group-by odd? xs)))
(println (str (sort v) " " (sort-by (fn [x] (- x)) '(1 3 2))))
(println (str (min 3 7) " " (max 3 7) " " (seq v) " " (empty? '()) " " (empty? v) " " (seq '())))
(exit 0)
