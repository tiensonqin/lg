;; M2: string / io / system builtins
(spit "/tmp/lg_io_test.txt" "hello lg\nline2")
(println (slurp "/tmp/lg_io_test.txt"))
(println (str (file-exists? "/tmp/lg_io_test.txt")))
(println (str (file-exists? "/tmp/lg_no_such_file")))
(println (str (env "LG_TEST_ENV")))
(println (str (env "LG_DEFINITELY_MISSING_VAR")))
(println (str (argv)))
(println (str (subs "hello" 1)))
(println (str (subs "hello" 1 3)))
(println (str (split "a,b,,c" ",")))
(println (join ["a" "b" "c"]))
(println (join "-" ["a" "b" "c"]))
(println (join ", " '(1 2 3)))
(println (str (trim "  hi  ")))
(println (str (triml "  hi  ")))
(println (str (trimr "  hi  ")))
(println (upper-case "hi"))
(println (lower-case "HI"))
(println (str (blank? "   ")))
(println (str (blank? " x ")))
(println (str (includes? "hello" "ell")))
(println (str (includes? "hello" "xyz")))
(println (str (starts-with? "hello" "he")))
(println (str (ends-with? "hello" "lo")))
(println (replace "a-b-c" "-" "+"))
(println (str (re-find "[0-9]+" "abc123def")))
(println (str (re-find "[0-9]+" "abc")))
(println (str (re-matches "[a-z]+" "abc")))
(println (str (re-matches "[a-z]+" "abc1")))
(println (str (re-seq "[0-9]+" "a1b22c333")))
(println (str (re-split "[0-9]+" "a1b22c333")))
(println (re-replace "[0-9]+" "a1b2" "#"))
(println (sh "echo hi"))
(println (str (< 0 (now-ms))))
