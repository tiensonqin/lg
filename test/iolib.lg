;; M2: string / io / system builtins
(:require [lg.str :as str] [lg.io :as io])
(io/spit "/tmp/lg_io_test.txt" "hello lg\nline2")
(println (io/slurp "/tmp/lg_io_test.txt"))
(println (str (io/file-exists? "/tmp/lg_io_test.txt")))
(println (str (io/file-exists? "/tmp/lg_no_such_file")))
(println (str (io/env "LG_TEST_ENV")))
(println (str (io/env "LG_DEFINITELY_MISSING_VAR")))
(println (str (io/argv)))
(println (str (str/subs "hello" 1)))
(println (str (str/subs "hello" 1 3)))
(println (str (str/split "a,b,,c" ",")))
(println (str/join ["a" "b" "c"]))
(println (str/join "-" ["a" "b" "c"]))
(println (str/join ", " '(1 2 3)))
(println (str (str/trim "  hi  ")))
(println (str (str/triml "  hi  ")))
(println (str (str/trimr "  hi  ")))
(println (str/upper-case "hi"))
(println (str/lower-case "HI"))
(println (str (str/blank? "   ")))
(println (str (str/blank? " x ")))
(println (str (str/includes? "hello" "ell")))
(println (str (str/includes? "hello" "xyz")))
(println (str (str/starts-with? "hello" "he")))
(println (str (str/ends-with? "hello" "lo")))
(println (str/replace "a-b-c" "-" "+"))
(println (str (str/re-find "[0-9]+" "abc123def")))
(println (str (str/re-find "[0-9]+" "abc")))
(println (str (str/re-matches "[a-z]+" "abc")))
(println (str (str/re-matches "[a-z]+" "abc1")))
(println (str (str/re-seq "[0-9]+" "a1b22c333")))
(println (str (str/re-split "[0-9]+" "a1b22c333")))
(println (str/re-replace "[0-9]+" "a1b2" "#"))
(println (io/sh "echo hi"))
(println (str (< 0 (io/now-ms))))
