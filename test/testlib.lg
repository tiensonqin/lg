;; the test library itself: deftest/is/testing/are + failure reporting
(ns testlib (:require [test :as t]))

(t/deftest arithmetic
  (t/is (= 4 (+ 2 2)))
  (t/is (= 6 (* 2 3)))
  (t/is (= 1 (- 4 3))))

(t/deftest strings
  (t/testing "concat"
    (t/is (= "ab" (str "a" "b"))))
  (t/testing "interp"
    (t/is (= "x1y" (str "x" 1 "y")))))

(t/deftest tables
  (t/are [x y] (= y (* x x))
    1 1
    2 4
    3 9
    5 25))

(t/deftest collections
  (t/are [coll n] (= n (count coll))
    [1 2 3] 3
    (list 1 2) 2
    #{1 2 3 4} 4
    {:a 1 :b 2} 2))

;; deliberate failure to exercise the report path (golden shows it)
(t/deftest bad
  (t/is (= 1 2)))

(println (str "failures: " (t/run-tests)))
(exit 0)
