;; defmacro hygiene: syntax-quote renamed binders, ~ / ~@, gensym, nested macros
(defmacro my-when [c & body] `(if ~c (do ~@body) ()))
(defmacro my-unless [c & body] `(if ~c () (do ~@body)))
(defmacro swap-inc [a] `(swap! ~a inc))

;; hygiene: the macro's internal `tmp` must not capture the caller's `tmp`
(defmacro twice [e] `(let [tmp ~e] (str tmp tmp)))
(def tmp "outer")
(def t2 (twice "in"))

;; gensym for a binding that *should* be shared across the expansion
(defmacro log-wrap [e]
  (let [g (gensym "v")]
    `(let [~g ~e] (do (println (str "v=" ~g)) ~g))))

(my-when true (println "when-ok"))
(my-unless false (println "unless-ok"))
(def c (atom 0))
(swap-inc c)
(println (str @c " " t2))
(println (log-wrap (+ 1 2)))
;; threading macros
(println (str (-> 5 (+ 3) (* 2)) " " (->> '(1 2 3) (map inc) (filter (fn [x] (> x 2))) (first))))
;; cond
(println (str (cond false "a" false "b" :else "z")))
;; defmacro with docstring — skipped like defn's
(defmacro twice-doc "evaluate x in a doubled context" [x] `(+ ~x ~x))
(println (str (twice-doc 21)))

;; multi-arity defmacro: dispatch on argument count, like defn
(defmacro greet-m
  ([x] `(str "hi " ~x))
  ([x y] `(str "hi " ~x " and " ~y)))
(println (greet-m "world"))
(println (greet-m "a" "b"))

;; each arity is an independent body; a `& rest` arity accepts at least
;; its fixed params
(defmacro mklist
  ([x] `(list ~x))
  ([x & xs] `(list ~x ~@xs)))
(println (str (mklist 1) " " (mklist 1 2 3)))

;; an arity may expand into a call of the same macro at another arity
(defmacro sumto-m
  ([n] `(sumto-m ~n 0))
  ([n acc] `(+ ~n ~acc)))
(println (str (sumto-m 5)))

;; docstring before the arity bodies
(defmacro mdoc "two arities" ([a] `(inc ~a)) ([a b] `(+ ~a ~b)))
(println (str (mdoc 10) " " (mdoc 10 20)))
(exit 0)
