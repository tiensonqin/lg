(:require [lg.str :as str])
(ns textutil)

;; tokenizer: lowercase, split on non-alpha, drop empties
(defn tokenize [s]
  (filter (fn [w] (not (str/blank? w))) (str/re-split "[^a-z]+" (str/lower-case s))))

;; top-k by count desc then word asc; key = (tuple -count word)
(defn top-k ^(fn [int (map string int)] (seq (tuple string int))) [k counts]
  (let [entries (into [] counts)]
    (take k (sort-by (fn [e] (tuple (- 0 (nth e 1)) (nth e 0))) entries))))
