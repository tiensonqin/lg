(ns features)

;; multi-arity defn
(defn greet
  ([x] (str "hi " x))
  ([x y] (str "hi " x " and " y)))

;; destructuring: fn params
(defn fst2 ^(fn [(vec int)] int) [[a b]] (+ a b))

;; let destructuring: vector + map
(def d-test
  (let [[x y] [10 20]
        {:keys [name age]} {:name "ann" :age 7}]
    (+ x y)))

;; match: literals, wildcard, vec-destructure
(defn describe [^any x]
  (match x
    0 "zero"
    [a b] (str "pair " a " " b)
    _ "other"))

;; builtins top-up
(def m {:a 1 :b 2})
(def v [3 1 2])

(println (greet "world"))
(println (greet "a" "b"))
(println (fst2 [4 5]))
(println "d-test" d-test)
(println (describe 0))
(println (describe [1 2]))
(println (describe "x"))
(println (select-keys m [:a]))
(println (update m :a inc))
(println (get-in {:a {:b {:c 42}}} [:a :b :c]))
(println (assoc-in {:a {:b 1}} [:a :c] 9))
(println ((comp inc inc) 5))
(println ((juxt inc dec) 10))
(println ((partial + 1) 41))
(println (mapcat (fn [x] (list x x)) '(1 2)))
(println (interpose 0 '(1 2 3)))
(println (reverse '(1 2 3)))
(println (distinct '(1 1 2 2 3)))
(println (second '(1 2 3)))
(println (last '(1 2 3)))
(println (butlast '(1 2 3)))
(println (min 3 7) (max 3 7))
(println (every? (fn [x] (> x 0)) '(1 2 3)))
(println (some (fn [x] (< x 0)) '(1 -2 3)))
(println (take-while (fn [x] (< x 3)) '(1 2 3 4)))
(println (drop-while (fn [x] (< x 3)) '(1 2 3 4)))
(println (zipmap '(a b) '(1 2)))
(println (sort '(3 1 2)))
(println (sort-by (fn [x] (- 0 x)) '(1 3 2)))
(println (group-by (fn [x] (match (mod x 2) 0 :even _ :odd)) '(1 2 3 4)))
(println (frequencies '(a b a c b a)))
