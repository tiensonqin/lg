(ns jsonp (:require [lg.str :as str] [json :as j]))

;; recursive-descent JSON parser: text -> (j/json) via (tuple value pos).
;; state is threaded explicitly; errors return (tuple jnull -1) — the
;; value slot carries a marker since lg has no exceptions.

(defvariant pr
  (pv [v json] [i int])
  (perr [msg string] [i int]))

(defn wschar? [c]
  (or (= c " ") (or (= c "\t") (or (= c "\n") (= c "\r")))))

(defn digit? [c] (str/includes? "0123456789" c))

(defn skip-ws ^(fn [string int] int) [s i]
  (match (and (< i (count s)) (wschar? (str/subs s i (+ i 1))))
    true (skip-ws s (+ i 1))
    false i))

;; scan [start, end) of s; end = first index failing pred, or len
(defn scan-num ^(fn [string int] int) [s i]
  (match (and (< i (count s))
              (str/includes? "0123456789+-.eE" (str/subs s i (+ i 1))))
    true (scan-num s (+ i 1))
    false i))

;; string literal: scan to closing quote; no escape handling
(defn parse-string ^(fn [string int] pr) [s i]
  (let [start (+ i 1)
        find-end (fn f [k]
                   (match (>= k (count s))
                     true -1
                     false (match (= (str/subs s k (+ k 1)) "\"")
                             true k
                             false (f (+ k 1)))))
        e (find-end start)]
    (match (< e 0)
      true (perr "unterminated string" i)
      false (pv (j/jstr (str/subs s start e)) (+ e 1)))))

;; literal keywords: true/false/null
(defn parse-literal ^(fn [string int] pr) [s i]
  (match (>= (+ i 4) (count s))
    true (perr "unexpected eof" i)
    false
    (match (str/includes? "true" (str/subs s i (+ i 4)))
    true (pv (j/jbool true) (+ i 4))
    false (match (str/includes? "false" (str/subs s i (+ i 5)))
            true (pv (j/jbool false) (+ i 5))
            false (match (str/includes? "null" (str/subs s i (+ i 4)))
                    true (pv j/jnull (+ i 4))
                    false (perr "bad literal" i))))))

(defn parse-number ^(fn [string int] pr) [s i]
  (let [e (scan-num s i)]
    (match (= e i)
      true (perr "bad number" i)
      false (pv (j/jnum (float (str/subs s i e))) e))))

;; forward: value parser dispatched on the next char
(declare parse-value)

;; array: [ v, v, ... ] — accumulates into a vec
(defn parse-arr-items ^(fn [string int (vec json)] pr) [s i acc]
  (let [k (skip-ws s i)]
    (match (>= k (count s))
      true (perr "unexpected eof" k)
      false
    (match (str/subs s k (+ k 1))
      "]" (pv (j/jarr acc) (+ k 1))
      _ (match (parse-value s k)
          (perr m e) (perr m e)
          (pv v k2)
            (let [k3 (skip-ws s k2)]
              (match (str/subs s k3 (+ k3 1))
                "," (parse-arr-items s (+ k3 1) (conj acc v))
                "]" (pv (j/jarr (conj acc v)) (+ k3 1))
                _ (perr "expected , or ]" k3))))))))

;; object: { "k": v, ... } — accumulates into (map string json)
(defn parse-obj-items ^(fn [string int (map string json)] pr) [s i acc]
  (let [k (skip-ws s i)]
    (match (>= k (count s))
      true (perr "unexpected eof" k)
      false
    (match (str/subs s k (+ k 1))
      "}" (pv (j/jobj acc) (+ k 1))
      "\"" (match (parse-string s k)
             (perr m e) (perr m e)
             (pv kvs k2)
               (let [kname (match kvs (j/jstr x) x _ "")
                     k3 (skip-ws s k2)]
                 (match (str/subs s k3 (+ k3 1))
                   ":" (match (parse-value s (skip-ws s (+ k3 1)))
                         (perr m e) (perr m e)
                         (pv vv k4)
                           (let [acc2 (assoc acc kname vv)
                                 k5 (skip-ws s k4)]
                             (match (str/subs s k5 (+ k5 1))
                               "," (parse-obj-items s (+ k5 1) acc2)
                               "}" (pv (j/jobj acc2) (+ k5 1))
                               _ (perr "expected , or }" k5))))
                   _ (perr "expected :" k3))))
      _ (perr "expected } or key" k)))))

(defn parse-value ^(fn [string int] pr) [s i]
  (let [k (skip-ws s i)]
    (match (>= k (count s))
      true (perr "empty input" k)
      false
        (let [c (str/subs s k (+ k 1))]
          (match c
            "{" (parse-obj-items s (+ k 1) {})
            "[" (parse-arr-items s (+ k 1) [])
            "\"" (parse-string s k)
            _ (match (or (digit? c) (= c "-"))
                true (parse-number s k)
                false (parse-literal s k)))))))

;; entry: parse then encode straight back
(let [text "{\"name\": \"lg\", \"tags\": [\"lang\", \"ocaml\"], \"n\": 2.5, \"ok\": true, \"none\": null}"]
  (match (parse-value text 0)
    (pv v i) (println (j/encode v))
    (perr m i) (println (str "error at " i ": " m))))
(match (parse-value "[1, 2.5, \"x\", false]" 0)
  (pv v i) (println (j/encode v))
  (perr m i) (println (str "error at " i ": " m)))
(match (parse-value "{\"a\": ]" 0)
  (pv v i) (println (j/encode v))
  (perr m i) (println (str "err " m)))
