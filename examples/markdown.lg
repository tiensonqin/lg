;; markdown-lite: .md -> .html renderer.
;; Covers headings (#..######), - / * bullet lists, ``` code fences,
;; and inline **bold** *em* `code` [text](url) — a real program
;; exercising reader/regex/string/match/variant/io/implicit paths.
(:require [lg.str :as str] [lg.io :as io])
(ns markdown)

(defvariant block
  (heading [level int] [text string])
  (para [text string])
  (code-block [text string])
  (list-block [items (list string)]))

;; ---------- line classification ----------

(defn heading-level [line]
  ;; re-matches is a full-string match; "#" followed by "#*" then space
  (match (str/re-find "^#+ " line)
    (Some m) (- (count m) 1)
    None 0))

(defn bullet? [line]
  (or (str/starts-with? line "- ") (str/starts-with? line "* ")))

(defn fence? [line]
  (str/starts-with? line "```"))

;; ---------- block grouping ----------

;; walk the lines once; `acc` is a reversed list of blocks, `buf` the
;; reversed lines of the open paragraph/list/code block.
;; acc is threaded through self-calls; declare its type so it stays a
;; concrete (list block) instead of widening to dyn.
(declare ^(fn [(list block) string (list string)] (list block)) flush)
(defn flush [acc kind buf]
  (match kind
    "para" (conj acc (para (str/join " " (reverse buf))))
    "list" (conj acc (list-block (reverse buf)))
    "code" (conj acc (code-block (str/join "\n" (reverse buf))))
    _ acc))

(defn group [lines]
  (let [recur (fn self [ls acc kind buf]
                (if (empty? ls)
                  (reverse (flush acc kind buf))
                  (let [line (nth ls 0 "")
                        more (rest ls)]
                    (if (fence? line)
                      (if (= kind "code")
                        (self more (flush acc kind buf) "none" (list))
                        (self more (flush acc kind buf) "code" (list)))
                      (if (= kind "code")
                        (self more acc "code" (conj buf line))
                        (let [lvl (heading-level line)]
                          (cond
                            (str/blank? line) (self more (flush acc kind buf) "none" (list))
                            (> lvl 0) (self more (conj (flush acc kind buf)
                                                     (heading lvl (str/trim (str/subs line lvl)))) "none" [])
                            (bullet? line) (self more acc "list" (conj buf (str/trim (str/subs line 2))))
                            (= kind "para") (self more acc "para" (conj buf line))
                            :else (self more (flush acc kind buf) "para" (list line)))))))))]
    (recur lines (list) "none" (list))))

;; ---------- inline rendering ----------

(defn escape-html [s]
  (str/re-replace ">" (str/re-replace "<" (str/re-replace "&" s "&amp;") "&lt;") "&gt;"))

;; nested calls apply inside-out: ** must be consumed before * sees it
(defn inline [s]
  (str/re-replace "\\[\\([^]]+\\)\\](\\([^)]+\\))"
    (str/re-replace "`\\([^`]+\\)`"
      (str/re-replace "\\*\\([^*]+\\)\\*"
        (str/re-replace "\\*\\*\\([^*]+\\)\\*\\*" (escape-html s) "<strong>\\1</strong>")
        "<em>\\1</em>")
      "<code>\\1</code>")
    "<a href=\"\\2\">\\1</a>"))

;; ---------- block rendering ----------

(defn render [b]
  (match b
    (heading l t) (str "<h" (str l) ">" (inline t) "</h" (str l) ">")
    (para t) (str "<p>" (inline t) "</p>")
    (code-block t) (str "<pre><code>" (escape-html t) "</code></pre>")
    (list-block items)
      (str "<ul>"
           (str/join "" (map (fn [i] (str "<li>" (inline i) "</li>")) items))
           "</ul>")))

;; ---------- driver ----------

(defn render-md [src]
  (str "<!DOCTYPE html>\n<html><body>\n"
       (str/join "\n" (map render (group (str/split src "\n"))))
       "\n</body></html>"))

(let [path (match (first (io/argv)) (Some p) p None "examples/markdown.md")]
  (io/spit (str (str/re-replace "\\.md$" path "") ".html")
        (render-md (io/slurp path)))
  (println (str "markdown: rendered " path)))
