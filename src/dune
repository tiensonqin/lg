(copy_files ../runtime/runtime_format_spec.ml)

; Embed docs/errors/*.md so `lg --explain` works without repo access, and
; fail the build when the docs and the Error_code registry drift apart.
(rule
 (target error_docs.ml)
 (deps gen_error_docs.py error_code.ml (source_tree ../docs/errors))
 (action
  (with-stdout-to %{target}
   (run python3 %{dep:gen_error_docs.py} %{workspace_root}))))

(library
 (name lg)
 (public_name lg)
 ; Inline small helpers: cold builds pay for both compiler construction
 ; and the compiler's subsequent type inference and code generation.
 (ocamlopt_flags :standard -Oclassic -inline 10 -no-g)
 (libraries compiler-libs.common lg_compiler_support unix))
