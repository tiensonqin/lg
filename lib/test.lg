;; lg test library - clojure.test-style framework.
;; Usage:
;;   (ns my-test (:require [test :as t]))
;;   (t/deftest addition (t/is (= 4 (+ 2 2))))
;;   (exit (t/run-tests))
;;
;; deftest registers a zero-arg test under a quoted name, in definition
;; order; is checks a boolean form and reports FAIL <name>: <form> on
;; failure; testing adds a context label to failures inside it; are
;; expands rows into is checks; run-tests runs every registered test
;; and returns the failure count (feed to `exit` for a status code).

(ns test)

(def test-order "Test names in definition order (used by macro expansions)." ^(atom (vec symbol)) (atom []))
(def tests "Registry of deftest bodies, keyed by name." ^(atom (map symbol (fn [] unit))) (atom {}))
(def checks "Count of is-checks run so far." ^(atom int) (atom 0))
(def failures "Count of failed checks." ^(atom int) (atom 0))
(def current "Name of the test currently running." ^(atom symbol) (atom 'none))
(def contexts "Active testing-label stack." ^(atom (vec string)) (atom []))

(defn pass "Record a passing check (called by the is expansion)." []
  (do (swap! checks inc)
      ()))

(defn ctx-str "Render the testing-label stack for failure messages." []
  (if (empty? (deref contexts))
      ""
      (str " " (deref contexts))))

(defn fail "Record a failed check and print FAIL <name>: <form>." [form]
  (do (swap! failures inc)
      (println (str "FAIL " (deref current) (ctx-str) ": " form))))

(defmacro deftest [name & body]
  `(do (def ~name (fn [] ~@body ()))
       (reset! test/test-order (conj (deref test/test-order) (symbol ~(str name))))
       (reset! test/tests (assoc (deref test/tests) (symbol ~(str name)) ~name))))

(defmacro is [form]
  `(if ~form (test/pass) (test/fail ~(str form))))

(defmacro testing [msg & body]
  `(do (reset! test/contexts (conj (deref test/contexts) ~msg))
       ~@body
       (reset! test/contexts (pop (deref test/contexts)))
       ()))

(defmacro are [argv expr & args]
  ;; (are [x y] (= x y) 1 1 2 2) -> (do (is (let [x 1 y 1] (= x y))) ...)
  (let [n (count argv)
        z (fn z [vs xs]
            (if (empty? vs)
                (list)
                (cons (first vs) (cons (first xs) (z (rest vs) (rest xs))))))
        mk (fn mk [xs]
             (if (empty? xs)
                 (list)
                 (cons `(is (let ~(apply vector (z argv (take n xs))) ~expr))
                       (mk (drop n xs)))))]
    (cons 'do (mk args))))

(defn run-tests "Run every registered deftest in definition order. Returns the failure count - feed to exit." []
  (let [order (deref test-order)
        ts (deref tests)]
    (do
      (mapv (fn [k] (do (reset! current k)
                        (reset! contexts [])
                        (if-let [f (get ts k)] (f) ())))
            order)
      (println (str (deref checks) " checks, " (deref failures) " failures"))
      (deref failures))))
